# GameAnalytics credentials
# Get keys from https://gameanalytics.com — create a project for each environment
VITE_GA_GAME_KEY=your_game_key_here
VITE_GA_SECRET_KEY=your_secret_key_here

# Sentry (optional -- leave empty to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Sentry source map upload (CI only — read by Vite build process, not embedded in bundle)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
